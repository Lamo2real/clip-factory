{
  "name": "@clipfactory/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clip Factory web app: React 19 + Vite PWA on CloudFront.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json && vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:mock": "vite preview --outDir dist-mock --port 4179 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "aws-amplify": "^6.22.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
