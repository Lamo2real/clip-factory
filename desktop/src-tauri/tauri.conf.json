{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Factory",
  "version": "1.0.0",
  "identifier": "app.clipfactory.desktop",
  "build": {},
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "publisher": "Clip Factory",
    "category": "Video",
    "shortDescription": "Turn long videos into short clips",
    "longDescription": "Clip Factory in its own window. Paste a link, get short vertical clips, review them, and post.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
