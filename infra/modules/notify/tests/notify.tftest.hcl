# Offline plan test (mock AWS provider, no credentials, no AWS calls; the tls provider makes a throwaway key locally):
#   cd infra/modules/notify && terraform init -backend=false && terraform test
#
# docs/CONTRACTS.md §32.2 and §32.5: the VAPID key is written only through the write-only argument (never in the plan
# or the state) and is never destroyed; cf-prod-notify reads only MODIFY records of JOB# items (and the Content Rewards
# items of §38.11 and §41.4 and Get paid's of §40.7), can never delete anything and may read only its own secret. The
# filter is one pattern on the same mapping, so a new prefix is an in-place change of that mapping.

mock_provider "aws" {
  override_during = plan

  mock_resource "aws_cloudwatch_log_group" {
    defaults = { arn = "arn:aws:logs:eu-north-1:123456789012:log-group:/aws/lambda/cf-test-notify" }
  }
  mock_resource "aws_secretsmanager_secret" {
    defaults = { arn = "arn:aws:secretsmanager:eu-north-1:123456789012:secret:cf-test/notify/vapid-AbCdEf" }
  }
  mock_resource "aws_lambda_function" {
    defaults = { arn = "arn:aws:lambda:eu-north-1:123456789012:function:cf-test-notify" }
  }
}

variables {
  name = "cf-test"
  # Any existing file: the module only hashes it.
  lambda_zip_path = "main.tf"
  table_name      = "cf-test-data"
  table_arn       = "arn:aws:dynamodb:eu-north-1:123456789012:table/cf-test-data"
  stream_arn      = "arn:aws:dynamodb:eu-north-1:123456789012:table/cf-test-data/stream/2026-01-01T00:00:00.000"
  app_url         = "https://d111111abcdef8.cloudfront.net"
}

run "vapid_key_is_write_only_and_kept" {
  command = plan

  assert {
    condition     = aws_secretsmanager_secret.vapid.name == "cf-test/notify/vapid"
    error_message = "The VAPID key lives in cf-test/notify/vapid."
  }

  assert {
    condition     = aws_secretsmanager_secret_version.vapid.secret_string_wo_version == 1 && length(regexall("(?m)^\\s+secret_string\\s+=", file("main.tf"))) == 0
    error_message = "The VAPID key must be written with secret_string_wo (never secret_string), so it never enters the plan or the state."
  }

  assert {
    condition     = length(regexall("(?s)resource \"aws_secretsmanager_secret_version\" \"vapid\".*?prevent_destroy = true", file("main.tf"))) == 1 && aws_secretsmanager_secret_version.vapid.secret_id != "" && length(regexall("ephemeral \"tls_private_key\" \"vapid\"", file("main.tf"))) == 1 && length(regexall("resource \"tls_private_key\"", file("main.tf"))) == 0
    error_message = "The key is generated by the ephemeral tls_private_key (a tls_private_key resource would store it in the state)."
  }

  assert {
    condition     = aws_secretsmanager_secret.vapid.name != "" && length(regexall("(?s)resource \"aws_secretsmanager_secret\" \"vapid\".*?prevent_destroy\\s*=\\s*true", file("main.tf"))) == 1
    error_message = "The VAPID secret must carry prevent_destroy: a new key would end every device's subscription."
  }
}

run "notify_reads_job_changes_and_can_never_delete" {
  command = plan

  assert {
    condition     = one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern == jsonencode({ eventName = ["MODIFY"], dynamodb = { Keys = { sk = { S = [{ prefix = "JOB#" }, { prefix = "CAMPAIGN#" }, { prefix = "CRSUB#" }, { prefix = "CRMONEY" }, { prefix = "CRCONN" }, { prefix = "CRFIND" }, { prefix = "PAYSTATE#" }] } } } })
    error_message = "cf-test-notify reads only MODIFY records of JOB# items, the Content Rewards CAMPAIGN#, CRSUB#, CRMONEY, CRCONN (§38.11) and CRFIND (§41.4) items and Get paid's PAYSTATE# (§40.7), one pattern."
  }

  # §41.4: "3 new campaigns match" comes from a MODIFY of CRFIND (the look only updates it, never creates it). The
  # shared CRPUBLIC cache (CAMP#{uuid}, PUB#{uuid}, STATE), CROWNERS' USER# rows and the NOTIFIED# dedupe items never
  # reach cf-test-notify.
  assert {
    condition = (
      jsondecode(one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern).eventName == ["MODIFY"] &&
      anytrue([for p in jsondecode(one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern).dynamodb.Keys.sk.S : startswith("CRFIND", p.prefix)]) &&
      alltrue([for sk in ["CAMP#3d9ef19f-0000-4000-8000-000000000000", "PUB#3d9ef19f-0000-4000-8000-000000000000", "STATE", "USER#u1", "NOTIFIED#cr#finder:2026112112:3"] :
      !anytrue([for p in jsondecode(one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern).dynamodb.Keys.sk.S : startswith(sk, p.prefix)])])
    )
    error_message = "Only MODIFY records; CRFIND must pass, CRPUBLIC's CAMP#, PUB# and STATE, CROWNERS' USER# and NOTIFIED# must not."
  }

  assert {
    condition     = !strcontains(one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern, "PAYOUT#") && !strcontains(one(aws_lambda_event_source_mapping.notify.filter_criteria[0].filter).pattern, "PAYCONN#")
    error_message = "Get paid notifications come from PAYSTATE# only: a PAYOUT# row or a PAYCONN# change never wakes cf-test-notify."
  }

  assert {
    condition     = aws_lambda_event_source_mapping.notify.starting_position == "LATEST" && aws_lambda_event_source_mapping.notify.maximum_record_age_in_seconds == 600 && aws_lambda_event_source_mapping.notify.event_source_arn == var.stream_arn
    error_message = "The notify mapping reads the table's stream from LATEST and drops records older than 10 minutes (so a new prefix is an in-place filter change)."
  }

  assert {
    condition     = aws_lambda_function.notify.handler == "clipfactory_api.push.notify.handler" && aws_lambda_function.notify.environment[0].variables.PUSH_VAPID_SECRET == "cf-test/notify/vapid" && aws_lambda_function.notify.environment[0].variables.PUSH_SUBJECT == "https://d111111abcdef8.cloudfront.net"
    error_message = "cf-test-notify runs clipfactory_api.push.notify.handler with the key's name and the subject."
  }

  assert {
    condition     = length(regexall("DeleteItem|Scan|PutSecretValue|CreateSecret|DeleteSecret", aws_iam_role_policy.notify.policy)) == 0
    error_message = "cf-test-notify can never delete an item, scan the table or change a secret."
  }

  assert {
    condition     = output.function_names == { notify = "cf-test-notify" }
    error_message = "cf-test-notify is watched for errors."
  }
}
