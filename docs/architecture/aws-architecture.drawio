        <mxCell id="gha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;code&gt;ci.yml&lt;/code&gt;: every push and PR (pytest, ruff, mypy, web tests, terraform validate + test)&lt;br&gt;&lt;code&gt;deploy.yml&lt;/code&gt;: push to &lt;code&gt;main&lt;/code&gt;: Lambda zip (boto3 + durable SDK), agent image, plan + apply, web + &lt;code&gt;config.json&lt;/code&gt; (wsUrl), &lt;code&gt;version.json&lt;/code&gt;; desktop job on macOS + Windows runners" vertex="1">
          <mxGeometry x="24" y="2050" width="490" height="150" as="geometry" />
        </mxCell>
