        <mxCell id="e_learnskills" edge="1" parent="1" source="learn" target="media" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" value="&lt;b&gt;9&lt;/b&gt; read skills/*&lt;br&gt;(s3:GetObject only)">
          <mxGeometry x="-1" y="0" relative="1" as="geometry">
