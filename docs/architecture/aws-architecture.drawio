        </mxCell>
        <mxCell id="c73" edge="1" parent="1" source="oidc" style="endArrow=classic;html=1;rounded=0;fontSize=10;" target="state" value="plan / apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c74" edge="1" parent="1" source="gha" style="endArrow=classic;html=1;rounded=0;fontSize=10;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="ecr" value="docker push">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1030" /><mxPoint x="1225" y="1030" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="c75" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=1;fontColor=#0050EF;" value="How it works" vertex="1">
          <mxGeometry height="34" width="700" x="2580" y="5" as="geometry" />
        </mxCell>
        <mxCell id="c76" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;1. Sign in once a month at most.&lt;/b&gt; Cognito issues 15-minute tokens; the 30-day refresh token rotates on every use." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c77" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;2. Paste a YouTube, Twitch or Kick link, or upload a file&lt;/b&gt; (presigned PUT straight to S3)." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="132" as="geometry" />
        </mxCell>
        <mxCell id="c78" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;3. The API stores the job&lt;/b&gt; and starts an AgentCore session for it (&lt;code&gt;process_job&lt;/code&gt;)." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="204" as="geometry" />
        </mxCell>
        <mxCell id="c79" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;4. The agent downloads the audio and transcribes it&lt;/b&gt; with Amazon Transcribe, then measures loudness." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="276" as="geometry" />
        </mxCell>
        <mxCell id="c80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;5. Claude Fable 5.1 picks 5-10 moments&lt;/b&gt; using the owner's enabled skills and recent learnings." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="348" as="geometry" />
        </mxCell>
        <mxCell id="c81" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;6. ffmpeg renders each clip&lt;/b&gt; (1080x1920, facecam on top, hook, captions, cover); the checklist runs; captions are written per platform." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c82" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;7. The owner reviews every clip and presses Confirm&lt;/b&gt; (or Decline). Confirm queues one post per platform." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="492" as="geometry" />
        </mxCell>
        <mxCell id="c83" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;8. 48 hours after posting&lt;/b&gt; a one-time schedule reads the metrics and Claude distils a learning for the next jobs (phase 2)." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="564" as="geometry" />
        </mxCell>
        <mxCell id="c84" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;Watchdog:&lt;/b&gt; a running job with no heartbeat for 15 minutes is marked failed, so the owner can press Retry." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="636" as="geometry" />
        </mxCell>
        <mxCell id="c85" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;Legend:&lt;/b&gt; solid arrow = request or data flow built now; dashed = image pull, dead-letter or phase 2." vertex="1">
          <mxGeometry height="50" width="700" x="2580" y="852" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
