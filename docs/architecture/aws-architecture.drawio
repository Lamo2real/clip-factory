        <mxCell id="c86" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;9. Get the app.&lt;/b&gt; The sidebar offers what fits the device: the Mac &lt;code&gt;.dmg&lt;/code&gt; or Windows &lt;code&gt;.exe&lt;/code&gt; from &lt;code&gt;/downloads/&lt;/code&gt;, the browser install on Android, Add to Home Screen steps on iPhone. Hidden once installed." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="708" as="geometry" />
        </mxCell>
        <mxCell id="c87" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" value="&lt;b&gt;10. Updates.&lt;/b&gt; Each deploy writes &lt;code&gt;/version.json&lt;/code&gt; with 1-3 area labels (from &lt;code&gt;Area:&lt;/code&gt; commit lines). Open apps, the desktop app included, show a bar at the bottom with the labels and a Reload button." vertex="1">
          <mxGeometry height="64" width="700" x="2580" y="780" as="geometry" />
        </mxCell>
        <mxCell id="boxB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;arcSize=2;" value="" vertex="1">
