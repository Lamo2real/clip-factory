        </mxCell>
        <mxCell id="c60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=1;fontColor=#0050EF;" value="Delivery, security and operations - GitHub OIDC (no long-lived AWS keys); one account, one environment" vertex="1">
          <mxGeometry height="34" width="2460" x="20" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="gha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;code&gt;ci.yml&lt;/code&gt;: every push and PR (lint, types, tests, terraform validate)&lt;br&gt;&lt;code&gt;deploy.yml&lt;/code&gt;: push to &lt;code&gt;main&lt;/code&gt; (plan, apply, push image, upload web, then &lt;code&gt;release-areas.sh&lt;/code&gt; writes &lt;code&gt;/version.json&lt;/code&gt;)" vertex="1">
          <mxGeometry height="100" width="400" x="40" y="1155" as="geometry" />
        </mxCell>
