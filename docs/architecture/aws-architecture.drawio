          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tf" edge="1" parent="1" source="oidc" target="tfstate" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="plan / apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cw" edge="1" parent="1" source="cw" target="sns" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="alarm">
