        <mxCell id="cw_t" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=10;" value="&lt;b style=&quot;font-size:11px&quot;&gt;CloudWatch&lt;/b&gt;&lt;br&gt;JSON logs + X-Ray; alarms: Lambda errors, &lt;code&gt;DurableExecutionFailed&lt;/code&gt; / &lt;code&gt;TimedOut&lt;/code&gt;, broadcast iterator age, REST 5xx" vertex="1">
          <mxGeometry x="1680" y="2142" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sns" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;" value=" " vertex="1">
