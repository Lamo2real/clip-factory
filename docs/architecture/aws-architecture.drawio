  <diagram id="cfc" name="Clip Factory Cloud on AWS">
    <mxGraphModel dx="2368" dy="2048" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
