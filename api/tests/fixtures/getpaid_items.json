 },
 {
  "sk": "PAYCONN#adsense",
  "skPattern": "^PAYCONN#adsense$",
  "writtenBy": ["cf-prod-hooks", "cf-prod-api", "cf-prod-money"],
  "attributes": ["type", "userId", "source", "status", "accounts", "connectedAt", "scopes", "lastResult", "reason", "stoppedAt", "refreshLeaseUntil", "updatedAt"],
  "statuses": ["not_connected", "connected", "needs_reconnect"],
  "reasons": ["token_dead", "keys_changed"],
  "example": {"type": "payconn", "source": "adsense", "status": "connected", "connectedAt": "2026-11-01T09:00:00.000Z", "accounts": [{"name": "accounts/pub-1234567890123456", "displayName": "Main"}], "scopes": ["https://www.googleapis.com/auth/adsense.readonly"], "lastResult": "payments_allowed", "userId": "u1", "updatedAt": "2026-11-21T12:00:00.000Z"}
 },
 {
  "sk": "PAYCONN#whop",
  "skPattern": "^PAYCONN#whop$",
  "writtenBy": ["cf-prod-hooks", "cf-prod-api", "cf-prod-money"],
  "attributes": ["type", "userId", "source", "status", "accountId", "accountName", "connectedAt", "scopes", "lastResult", "reason", "keyHint", "stoppedAt", "tokenVersionId", "refreshLeaseUntil", "updatedAt"],
  "statuses": ["not_connected", "keys_saved", "connected", "needs_reconnect"],
  "reasons": ["token_dead", "keys_changed"],
  "example": {"type": "payconn", "source": "whop", "status": "connected", "connectedAt": "2026-11-01T09:00:00.000Z", "accountId": "user_abc123", "accountName": "@owner", "keyHint": "app_Ab…wxyz", "tokenVersionId": "v3", "userId": "u1", "updatedAt": "2026-11-21T12:00:00.000Z"}
 },
 {
  "sk": "PAYSTATE#youtube",
  "skPattern": "^PAYSTATE#youtube$",
  "writtenBy": ["cf-prod-money"],
  "attributes": ["type", "place", "source", "accounts", "holds", "alerts", "unpaid", "lastSent", "holdSince", "firstReadDone", "lastCheckedAt", "lastError"],
  "accountStates": ["READY", "NEEDS_ATTENTION", "CLOSED"],
  "example": {"type": "paystate", "place": "youtube", "source": "adsense", "accounts": [{"name": "accounts/pub-1234567890123456", "displayName": "Main", "state": "READY", "pendingTasks": []}], "holds": [{"type": "payment-hold", "severity": "SEVERE", "text": "Your payments are on hold."}], "alerts": [], "unpaid": {"text": "SEK 512.30"}, "firstReadDone": true, "lastCheckedAt": "2026-11-21T06:00:00.000Z", "lastSent": {"sk": "PAYOUT#youtube#2026-10-23#3456", "date": "2026-10-23", "text": "kr 1 234,56 SEK"}, "holdSince": "2026-11-20T06:00:00.000Z"}
 },
 {
  "sk": "PAYSTATE#contentrewards",
  "skPattern": "^PAYSTATE#contentrewards$",
  "writtenBy": ["cf-prod-money"],
  "attributes": ["type", "place", "source", "kyc", "methods", "lastPaidOutAt", "businesses", "hold", "lastSent", "payoutsMark", "firstReadDone", "lastCheckedAt", "lastError"],
  "kyc": ["not_started", "pending", "approved", "rejected", "unknown"],
  "holdKinds": ["id_rejected", "bank_broken", "payout_failed"],
  "example": {"type": "paystate", "place": "contentrewards", "source": "whop", "kyc": "approved", "methods": {"created": 1, "active": 0, "broken": 0, "ready": 1, "currencies": ["SEK"]}, "businesses": false, "firstReadDone": true, "lastCheckedAt": "2026-11-21T06:00:00.000Z", "hold": {"kind": "payout_failed", "since": "2026-11-18T06:00:00.000Z"}, "lastSent": {"sk": "PAYOUT#contentrewards#2026-11-10#po_3", "date": "2026-11-10", "amountMicros": 40000000, "currency": "USD"}, "lastPaidOutAt": "2026-11-10T08:00:00.000Z", "payoutsMark": "2026-11-10T08:00:00.000Z"}
 },
 {
  "sk": "PAYOUT#youtube#{yyyy-mm-dd}#{last 4 of the publisher id}",
  "skPattern": "^PAYOUT#youtube#[0-9]{4}-[0-9]{2}-[0-9]{2}#[A-Za-z0-9]{4}$",
  "writtenBy": ["cf-prod-money"],
  "attributes": ["type", "place", "by", "source", "account", "date", "amountText", "state", "fetchedAt", "revisedAt", "goneAt"],
  "states": ["sent", "gone"],
  "example": {"sk": "PAYOUT#youtube#2026-10-23#3456", "type": "payout", "place": "youtube", "by": "google", "source": "adsense.payments", "account": "3456", "date": "2026-10-23", "amountText": "kr 1 234,56 SEK", "state": "sent", "fetchedAt": "2026-11-21T06:00:00.000Z"}
 },
 {
  "sk": "PAYOUT#contentrewards#{created yyyy-mm-dd}#{payoutId}",
  "skPattern": "^PAYOUT#contentrewards#[0-9]{4}-[0-9]{2}-[0-9]{2}#[A-Za-z0-9_]+$",
  "writtenBy": ["cf-prod-money"],
  "attributes": ["type", "place", "by", "source", "payoutId", "status", "state", "date", "amountMicros", "currency", "estimatedArrival", "traceCode", "fetchedAt", "updatedAt"],
  "internal": ["traceCode"],
  "statusToState": {"completed": "sent", "requested": "on_its_way", "in_review": "on_its_way", "processing": "on_its_way", "failed": "didnt_go_through", "canceled": "didnt_go_through", "denied": "didnt_go_through", "reversed": "came_back"},
  "example": {"sk": "PAYOUT#contentrewards#2026-11-10#po_3", "type": "payout", "place": "contentrewards", "by": "whop", "source": "whop.payouts", "payoutId": "po_3", "status": "completed", "state": "sent", "date": "2026-11-10", "amountMicros": 40000000, "currency": "USD", "traceCode": "UETR-secret-trace", "fetchedAt": "2026-11-21T06:00:00.000Z", "estimatedArrival": "2026-11-14"}
 }
]
